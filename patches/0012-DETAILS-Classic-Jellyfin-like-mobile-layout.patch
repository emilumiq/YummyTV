+package su.afk.yummy.tv.feature.details.mobile.details.classic
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.material.MaterialTheme
+import androidx.compose.material.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import su.afk.yummy.tv.core.model.anime.AnimeDetails
+import su.afk.yummy.tv.feature.details.mobile.details.utils.formatAiredProgress
+import su.afk.yummy.tv.feature.details.mobile.details.utils.formatViews
+
+@Composable
+internal fun ClassicDetailsMeta(
+    details: AnimeDetails,
+    modifier: Modifier = Modifier,
+) {
+    val metaLine = buildList {
+        details.year?.let { add(it.toString()) }
+        details.type?.takeIf { it.isNotBlank() }?.let { add(it) }
+        details.status?.takeIf { it.isNotBlank() }?.let { add(it) }
+        details.ageRating?.takeIf { it.isNotBlank() }?.let { add(it) }
+        details.views?.let { add(it.formatViews()) }
+    }.joinToString(" • ")
+    val genresLine = details.genres.take(5).joinToString(" • ") { it.title }
+    val progressLine = details.episodes?.formatAiredProgress(details.status)
+    if (metaLine.isBlank() && genresLine.isBlank() && progressLine == null) return
+
+    Column(
+        modifier = modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(4.dp),
+    ) {
+        if (metaLine.isNotBlank()) {
+            Text(
+                text = metaLine,
+                style = MaterialTheme.typography.body2,
+                fontWeight = FontWeight.Medium,
+                color = MaterialTheme.colors.onBackground.copy(alpha = 0.78f),
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+        if (genresLine.isNotBlank()) {
+            Text(
+                text = genresLine,
+                style = MaterialTheme.typography.body2,
+                color = MaterialTheme.colors.onBackground.copy(alpha = 0.66f),
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+        progressLine?.let { progress ->
+            Text(
+                text = progress,
+                style = MaterialTheme.typography.body2,
+                fontWeight = FontWeight.Bold,
+                color = MaterialTheme.colors.onBackground.copy(alpha = 0.86f),
+            )
+        }
+    }
+}
