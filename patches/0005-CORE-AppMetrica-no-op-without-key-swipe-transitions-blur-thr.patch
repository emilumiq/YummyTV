+package su.afk.yummy.tv.core.analytics.appmetrica
+
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Единый флаг «AppMetrica.activate вызван». Без API-ключа (пустой
+ * `yummytv.appmetricaApiKey` в local.properties) инициализатор молча пропускает
+ * активацию, и любой прямой вызов AppMetrica бросает ValidationException —
+ * трекер по этому флагу превращается в no-op вместо краша на старте.
+ */
+@Singleton
+internal class AppMetricaActivation @Inject constructor() {
+
+    @Volatile
+    var isActivated: Boolean = false
+}
