+package su.afk.yummy.tv.domain.tracker.usecase
+
+import su.afk.yummy.tv.domain.tracker.repository.TrackerAuthRepository
+import javax.inject.Inject
+
+/**
+ * Signs out of AniList: clears token and session. Port of `Anilist.logout`.
+ */
+class LogoutTrackerUseCase @Inject constructor(
+    private val authRepository: TrackerAuthRepository,
