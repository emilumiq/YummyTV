+package su.afk.yummy.tv.feature.tracker
+
+import androidx.navigation3.runtime.NavKey
+import kotlinx.serialization.Serializable
+
+/**
+ * Tracker destinations (AniList). Port of the Aniyomi tracking-settings entry point
+ * ([SettingsTrackingScreen]) — screens live in :feature:tracker:presentation.
+ */
+@Serializable
+sealed interface TrackerDestination : NavKey {
+
+    @Serializable
+    data object TrackerSettings : TrackerDestination
+
+    /** In-app OAuth page (WebView) for the AniList sign-in. */
+    @Serializable
