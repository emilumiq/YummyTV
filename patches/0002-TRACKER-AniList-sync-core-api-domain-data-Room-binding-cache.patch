@@ -0,0 +1,164 @@
+package su.afk.yummy.tv.data.tracker.repository
+
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import su.afk.yummy.tv.core.storage.tracker.TrackerBindingStorage
+import su.afk.yummy.tv.data.tracker.local.AniListSessionStore
+import su.afk.yummy.tv.data.tracker.mapper.AniListTrackMapper.toSearch
+import su.afk.yummy.tv.data.tracker.mapper.AniListTrackMapper.toTrack
+import su.afk.yummy.tv.data.tracker.remote.AniListApi
+import su.afk.yummy.tv.data.tracker.storage.mapper.TrackerBindingMapper.toDomain
+import su.afk.yummy.tv.data.tracker.storage.mapper.TrackerBindingMapper.toEntry
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrack
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrackSearch
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrackStatus
+import su.afk.yummy.tv.domain.tracker.repository.AnimeTrackRepository
+import su.afk.yummy.tv.domain.tracker.repository.TrackerAuthRepository
+import su.afk.yummy.tv.domain.tracker.utils.toAnimeTrackStatus
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Port of `Anilist.bind/refresh/update/delete` + `TrackEpisode.await` (anime part).
+ * Bindings persist in Room (tracker_binding), so they survive restarts; the server
+ * list stays the source of truth and overwrites stale rows on refresh.
+ */
+@Singleton
+class AniListAnimeTrackRepositoryImpl @Inject constructor(
+    private val api: AniListApi,
+    private val session: AniListSessionStore,
+    private val authRepository: TrackerAuthRepository,
+    private val bindingStorage: TrackerBindingStorage,
+) : AnimeTrackRepository {
+
+    private val mutex = Mutex()
+
+    override suspend fun searchAnime(query: String): List<AnimeTrackSearch> {
+        val token = requireLogin()
+        return api.searchAnime(token, query).data.page.media.map { it.toSearch() }
+    }
+
+    override suspend fun getBinding(animeId: Long): AnimeTrack? =
+        bindingStorage.getByAnimeId(animeId)?.toDomain()
+
+    override suspend fun bind(track: AnimeTrack, hasWatchedEpisodes: Boolean): AnimeTrack {
+        val token = requireLogin()
+        val userId = requireUserId()
+        val remote = api.findLibAnime(token, track.remoteId, userId)
+            .data.page.mediaList.firstOrNull()
+        val result = if (remote != null) {
+            val personal = remote.toTrack(track.animeId)
+            val merged = track.copy(
+                libraryId = personal.libraryId,
+                title = personal.title.ifBlank { track.title },
+                lastEpisodeSeen = personal.lastEpisodeSeen,
+                totalEpisodes = personal.totalEpisodes,
+                status = if (personal.status != AnimeTrackStatus.COMPLETED) {
+                    val isRewatching = personal.status == AnimeTrackStatus.REWATCHING
+                    if (!isRewatching && hasWatchedEpisodes) AnimeTrackStatus.WATCHING else personal.status
+                } else {
+                    personal.status
+                },
+                score = personal.score,
+                startDateMillis = personal.startDateMillis,
+                finishDateMillis = personal.finishDateMillis,
+                private = personal.private,
+                remoteUrl = track.remoteUrl.ifBlank { personal.remoteUrl },
+            )
+            api.updateLibAnime(token, merged)
+            merged
+        } else {
+            val fresh = track.copy(
+                status = if (hasWatchedEpisodes) AnimeTrackStatus.WATCHING else AnimeTrackStatus.PLAN_TO_WATCH,
+                score = 0.0,
+            )
+            val libraryId = api.addLibAnime(token, fresh)
+            fresh.copy(libraryId = libraryId)
+        }
+        bindingStorage.save(result.toEntry())
+        return result
+    }
+
+    override suspend fun refresh(track: AnimeTrack): AnimeTrack {
+        val token = requireLogin()
+        val userId = requireUserId()
+        val remote = api.findLibAnime(token, track.remoteId, userId)
+            .data.page.mediaList.firstOrNull()
+            ?: throw IllegalStateException("Anime ${track.remoteId} not found in AniList library")
+        val refreshed = track.copy(
+            title = remote.media.title.userPreferred,
+            totalEpisodes = remote.media.episodes ?: track.totalEpisodes,
+            lastEpisodeSeen = remote.progress.toDouble(),
+            status = remote.status.toAnimeTrackStatus(),
+            score = remote.scoreRaw.toDouble(),
+            startDateMillis = remote.startedAt.toEpochMilli(),
+            finishDateMillis = remote.completedAt.toEpochMilli(),
+            private = remote.private,
+            libraryId = remote.id,
+        )
+        bindingStorage.save(refreshed.toEntry())
+        return refreshed
+    }
+
+    override suspend fun markEpisodeSeen(animeId: Long, episodeNumber: Double): AnimeTrack? =
+        mutex.withLock {
+            val current = bindingStorage.getByAnimeId(animeId)?.toDomain() ?: return null
+            if (episodeNumber <= current.lastEpisodeSeen) return current
+            val token = requireLogin()
+            val refreshed = refresh(current)
+            val advanced = refreshed.copy(lastEpisodeSeen = episodeNumber).let { track ->
+                if (track.status != AnimeTrackStatus.COMPLETED) {
+                    if (track.lastEpisodeSeen.toLong() == track.totalEpisodes && track.totalEpisodes > 0) {
+                        track.copy(
+                            status = AnimeTrackStatus.COMPLETED,
+                            finishDateMillis = System.currentTimeMillis(),
+                        )
+                    } else if (track.status != AnimeTrackStatus.REWATCHING) {
+                        track.copy(
+                            status = AnimeTrackStatus.WATCHING,
+                            startDateMillis = if (track.lastEpisodeSeen == 1.0) System.currentTimeMillis() else track.startDateMillis,
+                        )
+                    } else {
+                        track
+                    }
+                } else {
+                    track
+                }
+            }
+            api.updateLibAnime(token, advanced)
+            bindingStorage.save(advanced.toEntry())
+            advanced
+        }
+
+    override suspend fun updateTrack(track: AnimeTrack): AnimeTrack {
+        val token = requireLogin()
+        // Same fallback as Anilist.update: a binding without a list id is re-resolved first.
+        val withLibrary = if (track.libraryId == null || track.libraryId == 0L) {
+            val userId = requireUserId()
+            val remote = api.findLibAnime(token, track.remoteId, userId)
+                .data.page.mediaList.firstOrNull()
+                ?: throw IllegalStateException("Anime ${track.remoteId} not found in AniList library")
+            track.copy(libraryId = remote.id)
+        } else {
+            track
+        }
+        api.updateLibAnime(token, withLibrary)
+        bindingStorage.save(withLibrary.toEntry())
+        return withLibrary
+    }
+
+    override suspend fun removeBinding(animeId: Long) {
+        val current = bindingStorage.getByAnimeId(animeId)?.toDomain() ?: return
+        bindingStorage.deleteByAnimeId(animeId)
+        val libraryId = current.libraryId ?: return
+        api.deleteLibAnime(requireLogin(), libraryId)
+    }
+
+    private suspend fun requireLogin(): String =
+        // Freshness + refresh-or-logout lives in TrackerAuthRepository.accessToken()
+        // (port of AnilistInterceptor); only userId from session here.
+        authRepository.accessToken().accessToken
+
+    private suspend fun requireUserId(): Int =
+        session.userId() ?: throw IllegalStateException("Not authenticated with AniList")
+}
