@@ -0,0 +1,32 @@
+package su.afk.yummy.tv.core.storage.db.migrations
+
+import androidx.room.migration.Migration
+import androidx.sqlite.db.SupportSQLiteDatabase
+
+/**
+ * Local AniList binding cache. The user's server list stays the source of truth —
+ * diverging rows are overwritten from the network, so no backfill is needed.
+ */
+internal val MIGRATION_54_55 = object : Migration(54, 55) {
+    override fun migrate(db: SupportSQLiteDatabase) {
+        db.execSQL(
+            """
+            CREATE TABLE IF NOT EXISTS tracker_binding (
+                animeId INTEGER NOT NULL,
+                remoteId INTEGER NOT NULL,
+                libraryId INTEGER,
+                title TEXT NOT NULL,
+                lastEpisodeSeen REAL NOT NULL,
+                totalEpisodes INTEGER NOT NULL,
+                statusId INTEGER NOT NULL,
+                score REAL NOT NULL,
+                remoteUrl TEXT NOT NULL,
+                startDateMillis INTEGER NOT NULL,
+                finishDateMillis INTEGER NOT NULL,
+                isPrivate INTEGER NOT NULL,
+                PRIMARY KEY(animeId)
+            )
+            """.trimIndent()
+        )
+    }
+}
