@@ -0,0 +1,26 @@
+package su.afk.yummy.tv.domain.tracker.utils
+
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrackStatus
+
+/**
+ * AnimeTrack <-> AniList GraphQL MediaListStatus enum mapping.
+ * Port of `AnilistUtils.kt` + `ALUserAnime.toTrackStatus()` (anime only).
+ */
+fun AnimeTrackStatus.toApiStatus(): String = when (this) {
+    AnimeTrackStatus.WATCHING -> "CURRENT"
+    AnimeTrackStatus.COMPLETED -> "COMPLETED"
+    AnimeTrackStatus.ON_HOLD -> "PAUSED"
+    AnimeTrackStatus.DROPPED -> "DROPPED"
+    AnimeTrackStatus.PLAN_TO_WATCH -> "PLANNING"
+    AnimeTrackStatus.REWATCHING -> "REPEATING"
+}
+
+fun String.toAnimeTrackStatus(): AnimeTrackStatus = when (this) {
+    "CURRENT" -> AnimeTrackStatus.WATCHING
+    "COMPLETED" -> AnimeTrackStatus.COMPLETED
+    "PAUSED" -> AnimeTrackStatus.ON_HOLD
+    "DROPPED" -> AnimeTrackStatus.DROPPED
+    "PLANNING" -> AnimeTrackStatus.PLAN_TO_WATCH
+    "REPEATING" -> AnimeTrackStatus.REWATCHING
+    else -> throw NotImplementedError("Unknown AniList status: $this")
+}
