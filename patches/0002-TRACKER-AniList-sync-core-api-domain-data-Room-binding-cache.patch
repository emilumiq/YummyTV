@@ -0,0 +1,73 @@
+package su.afk.yummy.tv.domain.tracker.utils
+
+import su.afk.yummy.tv.domain.tracker.model.AniListScoreFormat
+
+/**
+ * AniList scoring system. Port of `Anilist.getScoreList/indexToScore/displayScore`
+ * + `AnilistUtils.toApiScore` 1:1 — all POINT_* branches verbatim, including integer
+ * division in POINT_10 (`(score.toInt() / 10)` — not `score / 10`).
+ */
+object AniListScoreUtils {
+
+    fun getScoreList(format: AniListScoreFormat): List<String> = when (format) {
+        AniListScoreFormat.POINT_10 -> (0..10).map(Int::toString)
+        AniListScoreFormat.POINT_100 -> (0..100).map(Int::toString)
+        AniListScoreFormat.POINT_5 -> (0..5).map { "$it ★" }
+        AniListScoreFormat.POINT_3 -> listOf("-", "😦", "😐", "😊")
+        AniListScoreFormat.POINT_10_DECIMAL -> (0..100).map { (it / 10f).toString() }
+    }
+
+    /** Score-list index -> score on the POINT_100 scale (storage scale). */
+    fun indexToScore(format: AniListScoreFormat, index: Int): Double = when (format) {
+        AniListScoreFormat.POINT_10 -> index * 10.0
+        AniListScoreFormat.POINT_100 -> index.toDouble()
+        AniListScoreFormat.POINT_5 -> when (index) {
+            0 -> 0.0
+            else -> index * 20.0 - 10.0
+        }
+        AniListScoreFormat.POINT_3 -> when (index) {
+            0 -> 0.0
+            else -> index * 25.0 + 10.0
+        }
+        AniListScoreFormat.POINT_10_DECIMAL -> index.toDouble()
+    }
+
+    /** Score (POINT_100) -> UI text in the account format. */
+    fun displayScore(format: AniListScoreFormat, score: Double): String = when (format) {
+        AniListScoreFormat.POINT_5 -> when (score) {
+            0.0 -> "0 ★"
+            else -> "${((score + 10) / 20).toInt()} ★"
+        }
+        AniListScoreFormat.POINT_3 -> when {
+            score == 0.0 -> "0"
+            score <= 35 -> "😦"
+            score <= 60 -> "😐"
+            else -> "😊"
+        }
+        else -> score.toApiScore(format)
+    }
+
+    /** Score (POINT_100) -> string for GraphQL mutations. */
+    fun Double.toApiScore(format: AniListScoreFormat): String = when (format) {
+        AniListScoreFormat.POINT_10 -> (this.toInt() / 10).toString()
+        AniListScoreFormat.POINT_100 -> this.toInt().toString()
+        AniListScoreFormat.POINT_5 -> when {
+            this == 0.0 -> "0"
+            this < 30 -> "1"
+            this < 50 -> "2"
+            this < 70 -> "3"
+            this < 90 -> "4"
+            else -> "5"
+        }
+        AniListScoreFormat.POINT_3 -> when {
+            this == 0.0 -> "0"
+            this <= 35 -> ":("
+            this <= 60 -> ":|"
+            else -> ":)"
+        }
+        AniListScoreFormat.POINT_10_DECIMAL -> (this / 10).toString()
+    }
+
+    /** Score (POINT_100) -> 0..10 scale value for sliders. */
+    fun to10PointScore(score: Double): Double = score / 10.0
+}
diff --git a/feature/tracker/domain/src/main/kotlin/su/afk/yummy/tv/domain/tracker/utils/AniListStatusUtils.kt b/feature/tracker/domain/src/main/kotlin/su/afk/yummy/tv/domain/tracker/utils/AniListStatusUtils.kt
