+import java.time.ZoneId
+
+/** Port of `ALFuzzyDate` 1:1. */
+@Serializable
+data class ALFuzzyDate(
+    val year: Int? = null,
+    val month: Int? = null,
+    val day: Int? = null,
+) {
+
+    fun toEpochMilli(): Long = try {
+        LocalDate.of(year!!, month!!, day!!)
+            .atStartOfDay(ZoneId.systemDefault())
+            .toInstant()
+            .toEpochMilli()
+    } catch (_: Exception) {
+        0L
+    }
+}
