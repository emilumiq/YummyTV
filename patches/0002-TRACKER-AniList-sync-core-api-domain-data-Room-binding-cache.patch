+package su.afk.yummy.tv.core.storage.tracker
+
+internal class TrackerBindingStore(
+    private val dao: TrackerBindingDao,
+) : TrackerBindingStorage {
+
+    override suspend fun getByAnimeId(animeId: Long): TrackerBindingEntry? =
+        dao.getByAnimeId(animeId)
+
+    override suspend fun save(entry: TrackerBindingEntry) = dao.save(entry)
+
+    override suspend fun deleteByAnimeId(animeId: Long) = dao.deleteByAnimeId(animeId)
+}
