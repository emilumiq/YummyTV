+package su.afk.yummy.tv.core.storage.tracker
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.OnConflictStrategy
+import androidx.room.Query
+
+@Dao
+interface TrackerBindingDao {
+
+    @Query("SELECT * FROM tracker_binding WHERE animeId = :animeId")
+    suspend fun getByAnimeId(animeId: Long): TrackerBindingEntry?
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun save(entry: TrackerBindingEntry)
+
+    @Query("DELETE FROM tracker_binding WHERE animeId = :animeId")
+    suspend fun deleteByAnimeId(animeId: Long)
+}
