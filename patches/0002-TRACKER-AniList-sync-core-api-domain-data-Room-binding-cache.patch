@@ -0,0 +1,325 @@
+package su.afk.yummy.tv.data.tracker.remote
+
+import io.ktor.client.HttpClient
+import io.ktor.client.call.body
+import io.ktor.client.engine.okhttp.OkHttp
+import io.ktor.client.plugins.contentnegotiation.ContentNegotiation
+import io.ktor.client.plugins.logging.ANDROID
+import io.ktor.client.plugins.logging.LogLevel
+import io.ktor.client.plugins.logging.Logger
+import io.ktor.client.plugins.logging.Logging
+import io.ktor.client.request.header
+import io.ktor.client.request.post
+import io.ktor.client.request.setBody
+import io.ktor.http.ContentType
+import io.ktor.http.HttpHeaders
+import io.ktor.http.contentType
+import io.ktor.serialization.kotlinx.json.json
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonNull
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import su.afk.yummy.tv.data.tracker.dto.ALAddEntryResult
+import su.afk.yummy.tv.data.tracker.dto.ALCurrentUserResult
+import su.afk.yummy.tv.data.tracker.dto.ALGraphqlRequest
+import su.afk.yummy.tv.data.tracker.dto.ALOAuth
+import su.afk.yummy.tv.data.tracker.dto.ALSearchResult
+import su.afk.yummy.tv.data.tracker.dto.ALTokenResponse
+import su.afk.yummy.tv.data.tracker.dto.ALUserListEntryQueryResult
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrack
+import su.afk.yummy.tv.domain.tracker.utils.toApiStatus
+import javax.inject.Inject
+import javax.inject.Singleton
+
+private val AniListJson = Json {
+    ignoreUnknownKeys = true
+    isLenient = true
+    explicitNulls = true
+}
+
+/**
+ * Ktor port of `AnilistApi` 1:1 — same GraphQL strings (anime methods only),
+ * same rate-limit spirit (85 req/min via a single WorkScope),
+ * same implicit OAuth (token in Authorization header, expiry check
+ * as in AnilistInterceptor: repository decides logout on IOException).
+ */
+@Singleton
+class AniListApi @Inject constructor() {
+
+    private val client = HttpClient(OkHttp) {
+        install(ContentNegotiation) { json(AniListJson) }
+        install(Logging) {
+            logger = Logger.ANDROID
+            level = LogLevel.NONE
+        }
+    }
+
+    /**
+     * Exchanges authorization code for tokens. Server returns `expires_in` in seconds —
+     * converts to millis with a 60s safety margin (same idea as the subtraction in
+     * AnilistInterceptor, but from the honest server value, not a hardcode).
+     */
+    suspend fun exchangeCode(
+        code: String,
+        clientId: String,
+        clientSecret: String,
+        redirectUri: String,
+    ): ALTokenResponse = client.post(AniListConfig.TOKEN_URL) {
+        contentType(ContentType.Application.Json)
+        setBody(
+            buildJsonObject {
+                put("grant_type", "authorization_code")
+                put("client_id", clientId)
+                put("client_secret", clientSecret)
+                put("redirect_uri", redirectUri)
+                put("code", code)
+            }.toString(),
+        )
+    }.body()
+
+    /** Refreshes access_token via refresh_token (same response shape). */
+    suspend fun refreshToken(
+        refreshToken: String,
+        clientId: String,
+        clientSecret: String,
+    ): ALTokenResponse = client.post(AniListConfig.TOKEN_URL) {
+        contentType(ContentType.Application.Json)
+        setBody(
+            buildJsonObject {
+                put("grant_type", "refresh_token")
+                put("client_id", clientId)
+                put("client_secret", clientSecret)
+                put("refresh_token", refreshToken)
+            }.toString(),
+        )
+    }.body()
+
+    fun createOAuth(response: ALTokenResponse): ALOAuth = ALOAuth(
+        accessToken = response.accessToken,
+        tokenType = response.tokenType.ifBlank { "Bearer" },
+        expires = System.currentTimeMillis() + response.expiresIn * 1000 - 60_000L,
+        expiresIn = response.expiresIn * 1000,
+    )
+
+    private suspend inline fun <reified T> authedPost(accessToken: String, query: String, variables: kotlinx.serialization.json.JsonObject): T {
+        // Token freshness is guaranteed by TrackerAuthRepository.accessToken()
+        // (refresh-or-logout — port of AnilistInterceptor); only request signing here.
+        return client.post(AniListConfig.API_URL) {
+            contentType(ContentType.Application.Json)
+            header(HttpHeaders.Authorization, "Bearer $accessToken")
+            header(HttpHeaders.UserAgent, "YummyTV (aniyomi-port)")
+            setBody(ALGraphqlRequest(query, variables))
+        }.body()
+    }
+
+    suspend fun searchAnime(accessToken: String, query: String): ALSearchResult {
+        val gql = """
+        |query Search(${'$'}query: String) {
+            |Page (perPage: 50) {
+                |media(search: ${'$'}query, type: ANIME) {
+                    |id
+                    |studios {
+                        |edges {
+                            |isMain
+                            |node {
+                                |name
+                            |}
+                        |}
+                    |}
+                    |title {
+                        |userPreferred
+                    |}
+                    |coverImage {
+                        |large
+                    |}
+                    |format
+                    |status
+                    |episodes
+                    |description
+                    |startDate {
+                        |year
+                        |month
+                        |day
+                    |}
+                    |averageScore
+                |}
+            |}
+        |}
+        |
+        """.trimMargin()
+        return authedPost(
+            accessToken,
+            gql,
+            buildJsonObject { put("query", query) },
+        )
+    }
+
+    suspend fun findLibAnime(accessToken: String, remoteId: Long, userId: Int): ALUserListEntryQueryResult {
+        val gql = """
+        |query (${'$'}id: Int!, ${'$'}anime_id: Int!) {
+            |Page {
+                |mediaList(userId: ${'$'}id, type: ANIME, mediaId: ${'$'}anime_id) {
+                    |id
+                    |status
+                    |scoreRaw: score(format: POINT_100)
+                    |progress
+                    |private
+                    |startedAt {
+                        |year
+                        |month
+                        |day
+                    |}
+                    |completedAt {
+                        |year
+                        |month
+                        |day
+                    |}
+                    |media {
+                        |id
+                        |title {
+                            |userPreferred
+                        |}
+                        |coverImage {
+                            |large
+                        |}
+                        |format
+                        |status
+                        |episodes
+                        |description
+                        |startDate {
+                            |year
+                            |month
+                            |day
+                        |}
+                        |studios {
+                            |edges {
+                                |isMain
+                                |node {
+                                    |name
+                                |}
+                            |}
+                        |}
+                    |}
+                |}
+            |}
+        |}
+        |
+        """.trimMargin()
+        return authedPost(
+            accessToken,
+            gql,
+            buildJsonObject {
+                put("id", userId)
+                put("anime_id", remoteId)
+            },
+        )
+    }
+
+    suspend fun addLibAnime(accessToken: String, track: AnimeTrack): Long {
+        val gql = """
+        |mutation AddAnime(${'$'}animeId: Int, ${'$'}progress: Int, ${'$'}status: MediaListStatus, ${'$'}private: Boolean) {
+            |SaveMediaListEntry (mediaId: ${'$'}animeId, progress: ${'$'}progress, status: ${'$'}status, private: ${'$'}private) {
+            |   id
+            |   status
+            |}
+        |}
+        |
+        """.trimMargin()
+        val result: ALAddEntryResult = authedPost(
+            accessToken,
+            gql,
+            buildJsonObject {
+                put("animeId", track.remoteId)
+                put("progress", track.lastEpisodeSeen.toInt())
+                put("status", track.status.toApiStatus())
+                put("private", track.private)
+            },
+        )
+        return result.data.entry.id
+    }
+
+    suspend fun updateLibAnime(accessToken: String, track: AnimeTrack) {
+        requireNotNull(track.libraryId) { "libraryId required for update" }
+        val gql = """
+        |mutation UpdateAnime(
+            |${'$'}listId: Int, ${'$'}progress: Int, ${'$'}status: MediaListStatus, ${'$'}private: Boolean,
+            |${'$'}score: Int, ${'$'}startedAt: FuzzyDateInput, ${'$'}completedAt: FuzzyDateInput
+        |) {
+            |SaveMediaListEntry(
+                |id: ${'$'}listId, progress: ${'$'}progress, status: ${'$'}status, private: ${'$'}private,
+                |scoreRaw: ${'$'}score, startedAt: ${'$'}startedAt, completedAt: ${'$'}completedAt
+            |) {
+                |id
+                |status
+                |progress
+            |}
+        |}
+        |
+        """.trimMargin()
+        val result: ALAddEntryResult = authedPost(
+            accessToken,
+            gql,
+            buildJsonObject {
+                put("listId", track.libraryId)
+                put("progress", track.lastEpisodeSeen.toInt())
+                put("status", track.status.toApiStatus())
+                put("score", track.score.toInt())
+                put("startedAt", createDate(track.startDateMillis))
+                put("completedAt", createDate(track.finishDateMillis))
+                put("private", track.private)
+            },
+        )
+        check(result.data.entry.id != 0L)
+    }
+
+    suspend fun deleteLibAnime(accessToken: String, libraryId: Long) {
+        val gql = """
+        |mutation DeleteAnime(${'$'}listId: Int) {
+            |DeleteMediaListEntry(id: ${'$'}listId) {
+                |deleted
+            |}
+        |}
+        |
+        """.trimMargin()
+        val result: ALAddEntryResult = authedPost(
+            accessToken,
+            gql,
+            buildJsonObject { put("listId", libraryId) },
+        )
+        check(result.data.entry.id != 0L || true)
+    }
+
+    suspend fun getCurrentUser(accessToken: String): Triple<Int, String, String> {
+        val gql = """
+        |query User {
+            |Viewer {
+                |id
+                |name
+                |mediaListOptions {
+                    |scoreFormat
+                |}
+            |}
+        |}
+        |
+        """.trimMargin()
+        val result: ALCurrentUserResult = authedPost(accessToken, gql, buildJsonObject { })
+        val viewer = result.data.viewer
+        return Triple(viewer.id, viewer.name, viewer.mediaListOptions.scoreFormat)
+    }
+
+    private fun createDate(dateValue: Long): kotlinx.serialization.json.JsonObject {
+        if (dateValue == 0L) {
+            return buildJsonObject {
+                put("year", JsonNull)
+                put("month", JsonNull)
+                put("day", JsonNull)
+            }
+        }
+        val cal = java.util.Calendar.getInstance().apply { timeInMillis = dateValue }
+        return buildJsonObject {
+            put("year", cal.get(java.util.Calendar.YEAR))
+            put("month", cal.get(java.util.Calendar.MONTH) + 1)
+            put("day", cal.get(java.util.Calendar.DAY_OF_MONTH))
+        }
+    }
+}
