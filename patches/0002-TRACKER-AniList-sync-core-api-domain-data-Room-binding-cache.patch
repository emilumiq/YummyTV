+package su.afk.yummy.tv.domain.tracker.usecase
+
+import su.afk.yummy.tv.domain.tracker.repository.TrackerAuthRepository
+import javax.inject.Inject
+
+/**
+ * Extracts the authorization code from the redirect query (`?code=...`) and completes login
+ * (code→token exchange, Viewer request, session save). Pattern — Aniyomi code handlers:
+ * handleBangumi/handleMyAnimeList/handleShikimori/handleSimkl
+ * (also `data.getQueryParameter("code")` there).
+ */
+class HandleAniListCallbackUseCase @Inject constructor(
+    private val authRepository: TrackerAuthRepository,
+) {
+
+    suspend operator fun invoke(callbackUri: String) {
+        val code = parseCode(callbackUri)
+            ?: throw IllegalArgumentException("No code in callback uri")
+        authRepository.loginWithCode(code)
+    }
+
+    private fun parseCode(uri: String): String? {
+        // Code flow: yummytv://anilist-auth?code=XXX
+        val query = uri.substringAfter("?", missingDelimiterValue = "")
+        if (query.isEmpty()) return null
+        return query.split("&")
+            .firstOrNull { it.startsWith("code=") }
+            ?.substringAfter("=")
+            ?.takeIf { it.isNotBlank() }
+    }
+}
