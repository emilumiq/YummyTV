+package su.afk.yummy.tv.data.tracker.repository
+
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.combine
+import su.afk.yummy.tv.data.tracker.dto.ALOAuth
+import su.afk.yummy.tv.data.tracker.dto.isExpired
+import su.afk.yummy.tv.data.tracker.local.AniListSessionStore
+import su.afk.yummy.tv.data.tracker.remote.AniListApi
+import su.afk.yummy.tv.data.tracker.remote.AniListConfig
+import su.afk.yummy.tv.domain.tracker.model.AniListScoreFormat
+import su.afk.yummy.tv.domain.tracker.model.TrackerAuthState
+import su.afk.yummy.tv.domain.tracker.model.TrackerOAuth
+import su.afk.yummy.tv.domain.tracker.repository.TrackerAuthRepository
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Authorization Code flow: code→token exchange, Viewer, refresh_token session.
+ * Step logic — port of `Anilist.login` (createOAuth → getCurrentUser → save),
+ * transport — code flow instead of implicit (needs client_secret from config).
+ */
+@Singleton
+class AniListAuthRepositoryImpl @Inject constructor(
+    private val api: AniListApi,
+    private val session: AniListSessionStore,
+) : TrackerAuthRepository {
+
+    override fun observeAuthState(): Flow<TrackerAuthState> =
+        combine(session.oauth, session.username, session.scoreFormat) { oauth, username, format ->
+            TrackerAuthState(
+                // Same rule as AnilistInterceptor: an expired token means logged out.
+                isLoggedIn = oauth != null && !oauth.isExpired(),
+                // Unlike Aniyomi (which stores the numeric Viewer.id here), show the
+                // real profile name from Viewer.name. The numeric id is still kept in
+                // the session and sent to Page.mediaList, which requires userId.
+                username = username,
+                scoreFormat = format?.let(AniListScoreFormat::fromApiValue)
+                    ?: AniListScoreFormat.POINT_10,
+            )
+        }
+
+    override fun authUrl(): String = AniListConfig.authUrl()
+
+    override suspend fun loginWithCode(code: String) {
+        try {
+            val response = api.exchangeCode(
+                code = code,
+                clientId = AniListConfig.clientId,
+                clientSecret = AniListConfig.clientSecret,
+                redirectUri = AniListConfig.redirectUri,
+            )
+            val oauth = api.createOAuth(response)
+            val (userId, userName, scoreFormat) = api.getCurrentUser(oauth.accessToken)
+            session.saveSession(
+                oauth = oauth,
+                username = userName.ifBlank { userId.toString() },
+                userId = userId,
+                scoreFormat = scoreFormat,
+                refreshToken = response.refreshToken,
+            )
+        } catch (e: Throwable) {
+            session.clear()
+            throw e
+        }
+    }
+
+    override suspend fun accessToken(): TrackerOAuth {
+        val current = session.loadOAuth()
+            ?: throw IllegalStateException("Not authenticated with AniList")
+        if (!current.isExpired()) return current.toDomain()
+
+        val refresh = session.refreshToken()
+        if (refresh.isNullOrBlank()) {
+            // Port of AnilistInterceptor: nothing to refresh with — logout.
+            session.clear()
+            throw IllegalStateException("AniList token expired")
+        }
+        try {
+            val response = api.refreshToken(
+                refreshToken = refresh,
+                clientId = AniListConfig.clientId,
+                clientSecret = AniListConfig.clientSecret,
+            )
+            val fresh = api.createOAuth(response)
+            session.saveOAuth(fresh)
+            session.saveRefreshToken(response.refreshToken)
+            return fresh.toDomain()
+        } catch (e: Throwable) {
+            session.clear()
+            throw IllegalStateException("AniList session expired", e)
+        }
+    }
+
+    override suspend fun logout() {
+        session.clear()
+    }
+
+    private fun ALOAuth.toDomain() = TrackerOAuth(
+        accessToken = accessToken,
+        expiresAtMillis = expires,
+    )
+}
