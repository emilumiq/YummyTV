+package su.afk.yummy.tv.domain.tracker.repository
+
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrack
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrackSearch
+
+/**
+ * Watch-progress sync with AniList. Port of the Aniyomi AnimeTracker contract
+ * (searchAnime/bind/refresh/update) — anime part only.
+ */
+interface AnimeTrackRepository {
+
+    suspend fun searchAnime(query: String): List<AnimeTrackSearch>
+
+    suspend fun getBinding(animeId: Long): AnimeTrack?
+
+    /**
+     * Initial binding: looks up the entry in the user list (findLibAnime);
+     * if present — pulls personal fields, otherwise creates it (addLibAnime).
+     * Port of `Anilist.bind(track, hasWatchedEpisodes)`.
+     */
+    suspend fun bind(track: AnimeTrack, hasWatchedEpisodes: Boolean): AnimeTrack
+
+    /** Re-reads the entry personal fields from the server. Port of `Anilist.refresh`. */
+    suspend fun refresh(track: AnimeTrack): AnimeTrack
+
+    /**
+     * Confirms an episode watch: advances progress and pushes it to the server.
+     * Port of `Anilist.update(track, didWatchEpisode=true)` + `TrackEpisode.await`.
+     */
+    suspend fun markEpisodeSeen(animeId: Long, episodeNumber: Double): AnimeTrack?
+
+    /**
+     * Pushes an edited track (status, progress, score, dates, privacy) to AniList.
+     * Port of Aniyomi's `updateRemote` (called by every `setRemote*` setter).
+     */
+    suspend fun updateTrack(track: AnimeTrack): AnimeTrack
+
+    suspend fun removeBinding(animeId: Long)
+}
