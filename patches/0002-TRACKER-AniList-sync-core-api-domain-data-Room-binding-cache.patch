@@ -0,0 +1,27 @@
+package su.afk.yummy.tv.core.storage.tracker
+
+import androidx.room.Entity
+
+/**
+ * AniList binding of a Yummy title. One title holds one entry (seasons in Yummy
+ * are separate titles with their own animeId, so each season binds independently
+ * from its own page).
+ */
+@Entity(
+    tableName = "tracker_binding",
+    primaryKeys = ["animeId"],
+)
+data class TrackerBindingEntry(
+    val animeId: Long,
+    val remoteId: Long,
+    val libraryId: Long?,
+    val title: String,
+    val lastEpisodeSeen: Double,
+    val totalEpisodes: Long,
+    val statusId: Long,
+    val score: Double,
+    val remoteUrl: String,
+    val startDateMillis: Long,
+    val finishDateMillis: Long,
+    val isPrivate: Boolean,
+)
