+package su.afk.yummy.tv.domain.tracker.repository
+
+import kotlinx.coroutines.flow.Flow
+import su.afk.yummy.tv.domain.tracker.model.TrackerAuthState
+import su.afk.yummy.tv.domain.tracker.model.TrackerOAuth
+
+/**
+ * AniList auth: Authorization Code flow (code from redirect query),
+ * session storage, refresh via refresh_token, logout.
+ */
+interface TrackerAuthRepository {
+
+    fun observeAuthState(): Flow<TrackerAuthState>
+
+    /** Initial OAuth authorization URL (open in browser). */
+    fun authUrl(): String
+
+    /**
+     * Completes login with the redirect authorization code (code→token exchange,
+     * Viewer request, session save). Pattern — Aniyomi code handlers
+     * (handleBangumi/handleMyAnimeList/handleShikimori/handleSimkl).
+     */
+    suspend fun loginWithCode(code: String)
+
+    /**
+     * Valid GraphQL access_token: returns a fresh token directly, refreshes an expired one
+     * via refresh_token; nothing to refresh with — clears session and throws
+     * (port of the AnilistInterceptor + logout-on-expiry pair).
+     */
+    suspend fun accessToken(): TrackerOAuth
+
+    suspend fun logout()
+}
