+            trackingUrl = AniListConfig.animeUrl(id),
+            publishingStatus = status.orEmpty(),
+            publishingType = format?.replace("_", "-").orEmpty(),
+            startDate = if (startMillis != 0L) {
+                try {
+                    SimpleDateFormat("yyyy-MM-dd", Locale.US).format(java.util.Date(startMillis))
+                } catch (_: IllegalArgumentException) {
+                    ""
+                }
+            } else {
+                ""
+            },
+            studios = (studios?.edges.orEmpty())
+                .filter { it.isMain }
+                .ifEmpty { studios?.edges.orEmpty() }
+                .take(3)
+                .map { it.node.name },
+        )
+    }
+
+    fun ALUserListItem.toTrack(animeId: Long): AnimeTrack {
+        val anime = media
+        return AnimeTrack(
+            animeId = animeId,
+            remoteId = anime.id,
+            libraryId = id,
+            title = anime.title.userPreferred,
+            status = status.toAnimeTrackStatus(),
+            score = scoreRaw.toDouble(),
+            startDateMillis = startedAt.toEpochMilli(),
+            finishDateMillis = completedAt.toEpochMilli(),
+            lastEpisodeSeen = progress.toDouble(),
+            totalEpisodes = anime.episodes ?: 0L,
+            remoteUrl = AniListConfig.animeUrl(anime.id),
+            private = private,
+        )
+    }
+}
diff --git a/feature/tracker/data/src/main/kotlin/su/afk/yummy/tv/data/tracker/remote/AniListApi.kt b/feature/tracker/data/src/main/kotlin/su/afk/yummy/tv/data/tracker/remote/AniListApi.kt
