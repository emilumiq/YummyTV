diff --git a/feature/classic/ui/src/main/kotlin/su/afk/yummy/tv/feature/classic/ui/view/YummyChip.kt b/feature/classic/ui/src/main/kotlin/su/afk/yummy/tv/feature/classic/ui/view/YummyChip.kt
