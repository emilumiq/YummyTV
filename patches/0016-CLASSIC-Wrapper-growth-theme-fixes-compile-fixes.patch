@@ -0,0 +1,62 @@
+package su.afk.yummy.tv.feature.classic.ui.view
+
+import androidx.compose.foundation.layout.RowScope
+import androidx.compose.material.ExperimentalMaterialApi
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import su.afk.yummy.tv.core.designsystem.classic.LocalClassicUi
+
+@OptIn(ExperimentalMaterialApi::class)
+@Composable
+fun YummyFilterChip(
+    selected: Boolean,
+    onClick: () -> Unit,
+    label: @Composable () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+) {
+    if (LocalClassicUi.current) {
+        androidx.compose.material.FilterChip(
+            selected = selected,
+            onClick = onClick,
+            modifier = modifier,
+            enabled = enabled,
+        ) {
+            label()
+        }
+    } else {
+        androidx.compose.material3.FilterChip(
+            selected = selected,
+            onClick = onClick,
+            label = label,
+            modifier = modifier,
+            enabled = enabled,
+        )
+    }
+}
+
+@OptIn(ExperimentalMaterialApi::class)
+@Composable
+fun YummyAssistChip(
+    onClick: () -> Unit,
+    label: @Composable () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+) {
+    if (LocalClassicUi.current) {
+        androidx.compose.material.Chip(
+            onClick = onClick,
+            modifier = modifier,
+            enabled = enabled,
+        ) {
+            label()
+        }
+    } else {
+        androidx.compose.material3.AssistChip(
+            onClick = onClick,
+            label = label,
+            modifier = modifier,
+            enabled = enabled,
+        )
+    }
+}
