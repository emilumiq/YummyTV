@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# Rebuilds the yummy stack on a fresh upstream checkout:
+#   ./scripts/apply-patches.sh [<upstream-ref>] [<branch>]
+# Defaults: ref from upstream-commit, branch "yummy".
+# Conflicts stop the run — resolve, `git am --continue`, then re-export.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+upstream="${1:-$(cat upstream-commit)}"
+branch="${2:-yummy}"
+git checkout -B "$branch" "$upstream"
+git am --empty=drop patches/*.patch
+echo "applied $(wc -l < series) patches onto $upstream into $branch"
