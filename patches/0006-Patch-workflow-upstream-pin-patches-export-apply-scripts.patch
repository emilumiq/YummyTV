++                    hasWatchedEpisodes = (currentState.binding?.lastEpisodeSeen ?: 0.0) > 0.0,
++                )
++            }.onSuccess { track -> setState { copy(isBusy = false, binding = track) } }
++                .onFailure { setState { copy(isBusy = false, error = it.message) } }
++        }
++    }
++}
