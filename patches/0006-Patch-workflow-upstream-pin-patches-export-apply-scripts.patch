++
++/**
++ * TV variant of the in-app AniList sign-in page. Same interception as mobile;
++ * d-pad navigation inside the page is limited, the flow stays fully in-app.
++ */
++@SuppressLint("SetJavaScriptEnabled")
++@Composable
++fun TrackerAuthTvScreen(
++    state: TrackerState.State,
++    effect: Flow<TrackerState.Effect>,
++    onEvent: (TrackerState.Event) -> Unit,
++) {
++    var progress by remember { mutableStateOf(0) }
++
++    TrackerClassicTheme {
++        Column(
++            modifier = Modifier
++                .fillMaxSize()
++                .padding(horizontal = 48.dp, vertical = 24.dp),
++        ) {
++            Text(
++                text = stringResource(R.string.tracker_title),
++                style = MaterialTheme.typography.h5,
++                fontWeight = FontWeight.Bold,
++            )
++            if (progress in 1..99) {
++                LinearProgressIndicator(progress = progress / 100f)
++            }
++            if (state.authUrl.isNotBlank()) {
++                AndroidView(
++                    factory = { context ->
++                        WebView(context).apply {
++                            settings.javaScriptEnabled = true
++                            settings.domStorageEnabled = true
++                            webViewClient = object : WebViewClient() {
++                                override fun shouldOverrideUrlLoading(
++                                    view: WebView,
++                                    request: WebResourceRequest,
++                                ): Boolean {
++                                    val url = request.url.toString()
++                                    if (url.startsWith("yummytv://anilist-auth")) {
++                                        onEvent(TrackerState.Event.AuthCodeReceived(url))
++                                        return true
++                                    }
++                                    return false
++                                }
++                            }
++                            webChromeClient = object : WebChromeClient() {
++                                override fun onProgressChanged(view: WebView, newProgress: Int) {
++                                    progress = newProgress
++                                }
++                            }
++                            loadUrl(state.authUrl)
++                        }
++                    },
++                    modifier = Modifier.fillMaxSize(),
++                )
++            }
++        }
++    }
++}
