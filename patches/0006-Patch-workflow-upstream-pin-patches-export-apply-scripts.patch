++@HiltViewModel(assistedFactory = TrackerViewModel.Factory::class)
++class TrackerViewModel @AssistedInject internal constructor(
++    @Assisted private val dest: TrackerDestination,
++    override val errorHandler: ErrorHandler,
++    override val retryStorage: RetryStorage,
++    private val nav: INavigationManager,
