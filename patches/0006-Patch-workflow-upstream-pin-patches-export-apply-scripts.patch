++
++import su.afk.yummy.tv.data.tracker.BuildConfig
++
++/**
++ * AniList OAuth/endpoint config.
++ *
++ * Values come from BuildConfig (source — `local.properties`:
++ * `yummytv.anilistClientId`, `yummytv.anilistClientSecret`, `yummytv.anilistRedirectUri`;
++ * client: https://anilist.co/settings/developer, redirect `yummytv://anilist-auth`).
++ * No secrets in code — blank id only fails authUrl() with a clear message,
++ * rest of the build succeeds. Flow — Authorization Code (code→token exchange, like
++ * MAL/Shikimori in Aniyomi), not implicit: exchange secret also lives in config.
++ */
++object AniListConfig {
++
++    private const val FALLBACK_REDIRECT_URI = "yummytv://anilist-auth"
++
++    const val API_URL = "https://graphql.anilist.co/"
++    const val TOKEN_URL = "https://anilist.co/api/v2/oauth/token"
++    private const val BASE_OAUTH_URL = "https://anilist.co/api/v2/oauth/authorize"
++    private const val BASE_ANIME_URL = "https://anilist.co/anime/"
++
++    val clientId: String get() = BuildConfig.ANILIST_CLIENT_ID
++
++    val clientSecret: String get() = BuildConfig.ANILIST_CLIENT_SECRET
++
++    val redirectUri: String get() =
++        BuildConfig.ANILIST_REDIRECT_URI.ifBlank { FALLBACK_REDIRECT_URI }
++
++    fun animeUrl(mediaId: Long): String = BASE_ANIME_URL + mediaId
++
++    fun authUrl(): String {
++        val id = clientId.ifBlank {
++            throw IllegalStateException(
++                "AniList client id is not configured: " +
++                    "set yummytv.anilistClientId in local.properties " +
++                    "(client: https://anilist.co/settings/developer).",
++            )
++        }
++        return "$BASE_OAUTH_URL?client_id=$id&redirect_uri=$redirectUri&response_type=code"
++    }
++}
