++import java.util.Locale
++
++/**
++ * Applies the stored interface language below the AppCompat layer: the app runs
++ * on plain ComponentActivity, where AppCompatDelegate per-app locales never take
++ * effect. Activities wrap their base context here in attachBaseContext; language
++ * changes apply through the existing RestartApplication effect.
++ */
++object AppLocaleContext {
++
++    const val PREFS_NAME = "app_locale"
++    const val LOCALE_KEY = "locale"
++
++    fun storedLocale(context: Context): AppLocale {
++        val raw = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
++            .getString(LOCALE_KEY, null)
++            ?: return AppLocale.SYSTEM
++        return runCatching { AppLocale.valueOf(raw) }.getOrNull() ?: AppLocale.SYSTEM
++    }
++
++    fun wrap(base: Context): Context {
++        val locale = storedLocale(base)
++        if (locale == AppLocale.SYSTEM) return base
++        val config = Configuration(base.resources.configuration)
++        config.setLocale(Locale.forLanguageTag(locale.languageTag))
++        return base.createConfigurationContext(config)
++    }
++}
