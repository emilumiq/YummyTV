++/**
++ * Ktor port of `AnilistApi` 1:1 — same GraphQL strings (anime methods only),
++ * same rate-limit spirit (85 req/min via a single WorkScope),
++ * same implicit OAuth (token in Authorization header, expiry check
++ * as in AnilistInterceptor: repository decides logout on IOException).
++ */
++@Singleton
++class AniListApi @Inject constructor() {
++
++    private val client = HttpClient(OkHttp) {
++        install(ContentNegotiation) { json(AniListJson) }
++        install(Logging) {
++            logger = Logger.ANDROID
++            level = LogLevel.NONE
++        }
++    }
++
++    /**
++     * Exchanges authorization code for tokens. Server returns `expires_in` in seconds —
++     * converts to millis with a 60s safety margin (same idea as the subtraction in
++     * AnilistInterceptor, but from the honest server value, not a hardcode).
++     */
++    suspend fun exchangeCode(
++        code: String,
++        clientId: String,
++        clientSecret: String,
++        redirectUri: String,
++    ): ALTokenResponse = client.post(AniListConfig.TOKEN_URL) {
++        contentType(ContentType.Application.Json)
++        setBody(
++            buildJsonObject {
++                put("grant_type", "authorization_code")
++                put("client_id", clientId)
++                put("client_secret", clientSecret)
++                put("redirect_uri", redirectUri)
++                put("code", code)
++            }.toString(),
++        )
++    }.body()
++
++    /** Refreshes access_token via refresh_token (same response shape). */
++    suspend fun refreshToken(
++        refreshToken: String,
++        clientId: String,
++        clientSecret: String,
++    ): ALTokenResponse = client.post(AniListConfig.TOKEN_URL) {
++        contentType(ContentType.Application.Json)
++        setBody(
++            buildJsonObject {
++                put("grant_type", "refresh_token")
++                put("client_id", clientId)
++                put("client_secret", clientSecret)
++                put("refresh_token", refreshToken)
++            }.toString(),
++        )
++    }.body()
++
++    fun createOAuth(response: ALTokenResponse): ALOAuth = ALOAuth(
++        accessToken = response.accessToken,
++        tokenType = response.tokenType.ifBlank { "Bearer" },
++        expires = System.currentTimeMillis() + response.expiresIn * 1000 - 60_000L,
++        expiresIn = response.expiresIn * 1000,
++    )
