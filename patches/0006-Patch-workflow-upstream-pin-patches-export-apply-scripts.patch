++/**
++ * TV entry editor: status, episode stepper, score and privacy.
++ * Same draft as the mobile dialog, adjusted spacing for focus navigation.
++ */
++@OptIn(ExperimentalMaterialApi::class)
++@Composable
++internal fun TrackerEditDialog(
++    binding: AnimeTrack,
++    scoreFormat: AniListScoreFormat,
++    capabilities: TrackerCapabilities,
++    onDismiss: () -> Unit,
++    onSave: (status: AnimeTrackStatus, episodes: Int, scoreIndex: Int, private: Boolean) -> Unit,
++) {
++    val statuses = capabilities.animeStatusList
++    var status by remember(binding) { mutableStateOf(binding.status) }
++    val maxEpisodes = binding.totalEpisodes.takeIf { it > 0 }?.toInt() ?: 10_000
++    var episodes by remember(binding) {
++        mutableIntStateOf(binding.lastEpisodeSeen.toInt().coerceIn(0, maxEpisodes))
++    }
++    val scoreOptions = remember(scoreFormat) { AniListScoreUtils.getScoreList(scoreFormat) }
++    var scoreIndex by remember(binding, scoreOptions) {
++        mutableIntStateOf(
++            scoreOptions.indexOf(AniListScoreUtils.displayScore(scoreFormat, binding.score))
++                .takeIf { it >= 0 } ?: 0,
++        )
++    }
++    var isPrivate by remember(binding) { mutableStateOf(binding.private) }
++
++    AlertDialog(
++        onDismissRequest = onDismiss,
++        title = { Text(binding.title) },
++        text = {
++            Column(verticalArrangement = Arrangement.spacedBy(16.dp)) {
++                var statusExpanded by remember { mutableStateOf(false) }
++                ExposedDropdownMenuBox(
++                    expanded = statusExpanded,
++                    onExpandedChange = { statusExpanded = it },
++                ) {
++                    OutlinedTextField(
++                        value = status.label(),
++                        onValueChange = {},
++                        readOnly = true,
++                        label = { Text(stringResource(R.string.tracker_status)) },
++                        trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(statusExpanded) },
++                        modifier = Modifier.fillMaxWidth(),
++                    )
++                    ExposedDropdownMenu(
++                        expanded = statusExpanded,
++                        onDismissRequest = { statusExpanded = false },
++                    ) {
++                        statuses.forEach { option ->
++                            DropdownMenuItem(
++                                onClick = {
++                                    status = option
++                                    statusExpanded = false
++                                },
++                            ) {
++                                Text(option.label())
++                            }
++                        }
++                    }
++                }
++                Row(
++                    verticalAlignment = Alignment.CenterVertically,
++                    horizontalArrangement = Arrangement.spacedBy(16.dp),
++                ) {
++                    Text(
++                        text = stringResource(R.string.tracker_episodes),
++                        modifier = Modifier.weight(1f),
++                        style = MaterialTheme.typography.body1,
++                    )
++                    IconButton(
++                        onClick = { episodes = (episodes - 1).coerceAtLeast(0) },
++                        enabled = episodes > 0,
++                    ) {
++                        Icon(Icons.Filled.Remove, contentDescription = null)
++                    }
++                    Text(
++                        text = if (binding.totalEpisodes > 0) "$episodes / ${binding.totalEpisodes}"
++                        else "$episodes",
++                        style = MaterialTheme.typography.h6,
++                    )
++                    IconButton(
++                        onClick = { episodes = (episodes + 1).coerceAtMost(maxEpisodes) },
++                        enabled = episodes < maxEpisodes,
++                    ) {
++                        Icon(Icons.Filled.Add, contentDescription = null)
++                    }
++                }
++                var scoreExpanded by remember { mutableStateOf(false) }
++                ExposedDropdownMenuBox(
++                    expanded = scoreExpanded,
++                    onExpandedChange = { scoreExpanded = it },
++                ) {
++                    OutlinedTextField(
++                        value = scoreOptions.getOrElse(scoreIndex) { "" },
++                        onValueChange = {},
++                        readOnly = true,
++                        label = { Text(stringResource(R.string.tracker_score)) },
++                        trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(scoreExpanded) },
++                        modifier = Modifier.fillMaxWidth(),
++                    )
++                    ExposedDropdownMenu(
++                        expanded = scoreExpanded,
++                        onDismissRequest = { scoreExpanded = false },
++                    ) {
++                        scoreOptions.forEachIndexed { index, option ->
++                            DropdownMenuItem(
++                                onClick = {
++                                    scoreIndex = index
++                                    scoreExpanded = false
++                                },
++                            ) {
++                                Text(option)
++                            }
++                        }
++                    }
++                }
++                if (capabilities.supportsPrivateTracking) {
++                    Row(verticalAlignment = Alignment.CenterVertically) {
++                        Checkbox(
++                            checked = isPrivate,
++                            onCheckedChange = { isPrivate = it },
++                        )
++                        Text(
++                            stringResource(R.string.tracker_private),
++                            style = MaterialTheme.typography.body1,
++                        )
++                    }
++                }
++            }
++        },
++        confirmButton = {
++            TextButton(onClick = { onSave(status, episodes, scoreIndex, isPrivate) }) {
++                Text(stringResource(R.string.tracker_save))
++            }
++        },
++        dismissButton = {
++            TextButton(onClick = onDismiss) {
++                Text(stringResource(R.string.tracker_cancel))
++            }
++        },
++    )
++}
