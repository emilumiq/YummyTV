++) : BaseViewModel<TrackerState.State, TrackerState.Event, TrackerState.Effect>() {
++
++    @AssistedFactory
++    interface Factory {
++        fun create(dest: TrackerDestination): TrackerViewModel
++    }
++
++    override fun createInitialState(): TrackerState.State {
++        val anime = dest as? TrackerDestination.TrackerAnime
++        return TrackerState.State(
++            animeId = anime?.animeId,
++            animeTitle = anime?.title.orEmpty(),
++            searchQuery = anime?.title.orEmpty(),
++        )
++    }
++
++    private var searchJob: Job? = null
++
++    init {
++        runCatching { beginOAuth() }
++            .onSuccess { url -> setState { copy(authUrl = url) } }
++            .onFailure { setState { copy(error = it.message) } }
++        observeAuthState()
++            .onEach { auth -> setState { copy(authState = auth) } }
++            .launchIn(viewModelScope)
++        currentState.animeId?.let { loadBinding(it) }
++    }
++
++    override fun onEvent(event: TrackerState.Event) {
++        when (event) {
++            TrackerState.Event.BackSelected -> nav.back()
++
++            TrackerState.Event.LoginClicked -> nav.navigate(TrackerDestination.TrackerAuth)
++
++            is TrackerState.Event.AuthCodeReceived -> {
++                setState { copy(isBusy = true, error = null) }
++                viewModelScope.launch {
++                    runSuspendCatching { handleCallback(event.callbackUri) }
++                        .onSuccess { nav.back() }
++                        .onFailure { setState { copy(isBusy = false, error = it.message) } }
++                }
++            }
++
++            TrackerState.Event.LogoutClicked -> viewModelScope.launch {
++                runSuspendCatching { logout() }
++                    .onFailure { setState { copy(error = it.message) } }
++            }
++
++            is TrackerState.Event.SearchQueryChanged ->
++                setState { copy(searchQuery = event.query, error = null) }
++
++            TrackerState.Event.SearchSubmitted -> search(currentState.searchQuery)
++
++            is TrackerState.Event.BindSelected -> bind(event.search)
++
++            TrackerState.Event.RefreshClicked -> {
++                val animeId = currentState.animeId ?: return
++                setState { copy(isBusy = true, error = null) }
++                viewModelScope.launch {
++                    runSuspendCatching { refreshTrack(animeId) }
++                        .onSuccess { track -> setState { copy(isBusy = false, binding = track) } }
++                        .onFailure { setState { copy(isBusy = false, error = it.message) } }
++                }
++            }
++
++            is TrackerState.Event.TrackSaved -> saveTrack(event)
++
++            TrackerState.Event.UnbindClicked -> {
++                val animeId = currentState.animeId ?: return
++                viewModelScope.launch {
++                    runSuspendCatching { animeTrackRepository.removeBinding(animeId) }
++                        .onSuccess { setState { copy(binding = null) } }
++                        .onFailure { setState { copy(error = it.message) } }
++                }
++            }
++
++            TrackerState.Event.ErrorDismissed -> setState { copy(error = null) }
++        }
++    }
++
++    private fun loadBinding(animeId: Long) {
++        viewModelScope.launch {
++            runSuspendCatching { animeTrackRepository.getBinding(animeId) }
++                .onSuccess { setState { copy(binding = it) } }
++        }
++    }
++
++    private fun search(query: String) {
++        searchJob?.cancel()
++        if (query.isBlank()) {
++            setState { copy(searchResults = persistentListOf(), isSearching = false) }
++            return
++        }
++        setState { copy(isSearching = true, error = null) }
++        searchJob = viewModelScope.launch {
++            runSuspendCatching { searchAnime(query) }
++                .onSuccess {
++                    setState { copy(isSearching = false, searchResults = it.toImmutableList()) }
++                }
++                .onFailure { setState { copy(isSearching = false, error = it.message) } }
++        }
++    }
++
++    /**
++     * Applies the edit-dialog draft with the same transition rules as Aniyomi's
++     * `setRemoteAnimeStatus` (completing fills progress) and `setRemoteLastEpisodeSeen`
++     * (first progress starts watching, full progress completes).
++     */
++    private fun saveTrack(event: TrackerState.Event.TrackSaved) {
++        val current = currentState.binding ?: return
++        val format = currentState.authState.scoreFormat
++        var episodes = event.episodes.toDouble()
++        var status = event.status
++        if (status == AnimeTrackStatus.COMPLETED && current.totalEpisodes > 0) {
++            episodes = current.totalEpisodes.toDouble()
++        }
++        if (current.lastEpisodeSeen == 0.0 &&
++            current.lastEpisodeSeen < episodes &&
++            status != AnimeTrackStatus.REWATCHING
++        ) {
++            status = AnimeTrackStatus.WATCHING
++        }
++        var finishDate = current.finishDateMillis
++        if (current.totalEpisodes > 0 && episodes.toLong() == current.totalEpisodes) {
++            status = AnimeTrackStatus.COMPLETED
++            finishDate = System.currentTimeMillis()
++        }
++        val updated = current.copy(
++            status = status,
++            lastEpisodeSeen = episodes,
++            score = AniListScoreUtils.indexToScore(format, event.scoreIndex),
++            finishDateMillis = finishDate,
++            private = event.private,
++        )
++        setState { copy(isBusy = true, error = null) }
++        viewModelScope.launch {
++            runSuspendCatching { updateTrack(updated) }
++                .onSuccess { track -> setState { copy(isBusy = false, binding = track) } }
++                .onFailure { setState { copy(isBusy = false, error = it.message) } }
++        }
++    }
++
++    private fun bind(search: AnimeTrackSearch) {        val animeId = currentState.animeId ?: return
