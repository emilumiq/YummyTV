++package su.afk.yummy.tv.data.tracker.local
++
++import android.content.Context
++import androidx.datastore.preferences.core.edit
++import androidx.datastore.preferences.core.stringPreferencesKey
++import androidx.datastore.preferences.preferencesDataStore
++import dagger.hilt.android.qualifiers.ApplicationContext
++import kotlinx.coroutines.flow.Flow
++import kotlinx.coroutines.flow.first
++import kotlinx.coroutines.flow.map
++import kotlinx.serialization.json.Json
++import su.afk.yummy.tv.data.tracker.dto.ALOAuth
++import su.afk.yummy.tv.data.tracker.dto.isExpired
++import javax.inject.Inject
++import javax.inject.Singleton
++
++private val Context.aniListSession by preferencesDataStore(name = "anilist_session")
++
++/**
++ * AniList session in DataStore. Port of `saveOAuth/loadOAuth` + `trackUsername/trackPassword`
++ * (TrackPreferences) — token JSON, username, userId, scoreFormat as separate keys.
++ * NOTE: token is stored in plain text; move to Keystore (following
++ * SecureYaniAuthPreferences) — next iteration together with the Room bindings cache.
++ */
++@Singleton
++class AniListSessionStore @Inject constructor(
++    @ApplicationContext private val context: Context,
++) {
++
++    private val json = Json { ignoreUnknownKeys = true }
++
++    private val tokenKey = stringPreferencesKey("anilist_oauth")
++    private val usernameKey = stringPreferencesKey("anilist_username")
++    private val userIdKey = stringPreferencesKey("anilist_user_id")
++    private val scoreFormatKey = stringPreferencesKey("anilist_score_format")
++    private val refreshTokenKey = stringPreferencesKey("anilist_refresh_token")
++
++    val oauth: Flow<ALOAuth?> = context.aniListSession.data.map { prefs ->
++        prefs[tokenKey]?.let { raw ->
++            runCatching { json.decodeFromString<ALOAuth>(raw) }.getOrNull()
++        }
++    }
++
++    val username: Flow<String> = context.aniListSession.data.map { it[usernameKey].orEmpty() }
++
++    val scoreFormat: Flow<String?> = context.aniListSession.data.map { it[scoreFormatKey] }
++
++    suspend fun loadOAuth(): ALOAuth? = oauth.first()
++
++    suspend fun validOAuth(): ALOAuth? = loadOAuth()?.takeIf { !it.isExpired() }
++
++    suspend fun saveSession(
++        oauth: ALOAuth,
++        username: String,
++        userId: Int,
++        scoreFormat: String,
++        refreshToken: String = "",
++    ) {
++        context.aniListSession.edit { prefs ->
++            prefs[tokenKey] = json.encodeToString(oauth)
++            prefs[usernameKey] = username
++            prefs[userIdKey] = userId.toString()
++            prefs[scoreFormatKey] = scoreFormat
++            if (refreshToken.isNotBlank()) prefs[refreshTokenKey] = refreshToken
++            else prefs.remove(refreshTokenKey)
++        }
++    }
++
++    suspend fun saveOAuth(oauth: ALOAuth?) {
++        context.aniListSession.edit { prefs ->
++            if (oauth == null) prefs.remove(tokenKey)
++            else prefs[tokenKey] = json.encodeToString(oauth)
++        }
++    }
++
++    suspend fun userId(): Int? = context.aniListSession.data.map { it[userIdKey]?.toIntOrNull() }.first()
++
++    suspend fun refreshToken(): String? =
++        context.aniListSession.data.map { it[refreshTokenKey] }.first()
++
++    suspend fun saveRefreshToken(refreshToken: String) {
++        context.aniListSession.edit { prefs ->
++            if (refreshToken.isBlank()) prefs.remove(refreshTokenKey)
++            else prefs[refreshTokenKey] = refreshToken
++        }
++    }
++
++    suspend fun scoreFormat(): String? = context.aniListSession.data.map { it[scoreFormatKey] }.first()
++
++    suspend fun clear() {
++        context.aniListSession.edit { it.clear() }
++    }
++}
