++package su.afk.yummy.tv.data.tracker.deeplink
++
++import androidx.navigation3.runtime.NavKey
++import kotlinx.coroutines.CoroutineScope
++import kotlinx.coroutines.launch
++import su.afk.yummy.tv.core.deeplink.api.DeepLinkReference
++import su.afk.yummy.tv.core.deeplink.api.DeepLinkResolver
++import su.afk.yummy.tv.core.utils.coroutines.di.IoApplicationScope
++import su.afk.yummy.tv.core.utils.coroutines.runSuspendCatching
++import su.afk.yummy.tv.domain.tracker.usecase.HandleAniListCallbackUseCase
++import su.afk.yummy.tv.feature.tracker.TrackerDestination
++import javax.inject.Inject
++
++/**
++ * AniList OAuth callback (`yummytv://anilist-auth?code=...`): takes code from query,
++ * exchanges it for tokens in background and navigates to the tracker screen showing login result.
++ * Pattern — feature resolvers via `@IntoSet` (see LocalVideoDeepLinkResolver).
++ */
++internal class AniListAuthDeepLinkResolver @Inject constructor(
++    @param:IoApplicationScope private val scope: CoroutineScope,
++    private val handleCallback: HandleAniListCallbackUseCase,
++) : DeepLinkResolver {
++
++    override fun resolve(link: DeepLinkReference): NavKey? {
++        if (link.appLinkHost != CALLBACK_HOST) return null
++        val code = link.uri.getQueryParameter("code")
++        if (code.isNullOrBlank()) return null
++        scope.launch {
++            runSuspendCatching { handleCallback(link.uri.toString()) }
++        }
++        return TrackerDestination.TrackerSettings
++    }
++
++    private companion object {
++        const val CALLBACK_HOST = "anilist-auth"
++    }
++}
