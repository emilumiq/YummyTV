++          androidSdk
++          gradleFhs
++          pkgs.git
++          pkgs.curl
++          pkgs.jq
++        ];
++
++        gradleFhs = pkgs.buildFHSEnv {
++          name = "gradle-fhs";
++          targetPkgs = pkgs': with pkgs'; [
++            androidSdk
++            java
++            zlib
++            glib
++            nss
++            nspr
++            fontconfig
++            freetype
++            expat
++            libdrm
++            mesa
++            gcc
