--- /dev/null
+++ b/scripts/export-patches.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+# Regenerates patches/ + series from the yummy branch stack above upstream-commit.
+# Run after every commit; never hand-edit files under patches/.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+base="$(cat upstream-commit)"
+rm -rf patches
+mkdir -p patches
+git format-patch --no-signature -o patches "$base"..HEAD >/dev/null
+(cd patches && ls *.patch | sort) > series
+echo "exported $(wc -l < series) patches onto $(cat upstream-commit)"
