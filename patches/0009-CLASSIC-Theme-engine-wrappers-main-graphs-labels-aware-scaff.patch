+package su.afk.yummy.tv.feature.classic.ui.view
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import su.afk.yummy.tv.core.designsystem.classic.LocalClassicUi
+
+@Composable
+fun YummyLinearProgress(
+    progress: Float? = null,
+    modifier: Modifier = Modifier,
+) {
+    if (LocalClassicUi.current) {
+        if (progress != null) {
+            androidx.compose.material.LinearProgressIndicator(
+                progress = progress,
+                modifier = modifier,
+            )
+        } else {
+            androidx.compose.material.LinearProgressIndicator(modifier = modifier)
+        }
+    } else {
+        if (progress != null) {
+            androidx.compose.material3.LinearProgressIndicator(
+                progress = { progress },
+                modifier = modifier,
+            )
+        } else {
+            androidx.compose.material3.LinearProgressIndicator(modifier = modifier)
+        }
+    }
+}
