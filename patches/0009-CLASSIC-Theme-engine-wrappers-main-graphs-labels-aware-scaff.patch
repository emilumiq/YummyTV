+
+@Composable
+fun YummyDialog(
+    onDismissRequest: () -> Unit,
+    title: String,
+    text: String,
+    confirmLabel: String,
+    onConfirm: () -> Unit,
+    dismissLabel: String? = null,
+) {
+    if (LocalClassicUi.current) {
+        androidx.compose.material.AlertDialog(
+            onDismissRequest = onDismissRequest,
+            title = { androidx.compose.material.Text(title) },
+            text = { androidx.compose.material.Text(text) },
+            confirmButton = {
+                androidx.compose.material.TextButton(onClick = onConfirm) {
+                    androidx.compose.material.Text(confirmLabel)
+                }
+            },
+            dismissButton = dismissLabel?.let { label ->
+                {
+                    androidx.compose.material.TextButton(onClick = onDismissRequest) {
+                        androidx.compose.material.Text(label)
+                    }
+                }
+            },
+        )
