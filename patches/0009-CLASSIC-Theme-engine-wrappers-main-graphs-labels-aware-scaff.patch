+package su.afk.yummy.tv.feature.classic.ui
+
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import su.afk.yummy.tv.core.designsystem.classic.ClassicMaterialTheme
+import su.afk.yummy.tv.core.designsystem.classic.LocalClassicUi
+import su.afk.yummy.tv.core.designsystem.theme.YummyTvTheme
+import su.afk.yummy.tv.core.model.settings.AppTheme
+import su.afk.yummy.tv.core.model.settings.BackgroundStyle
+import su.afk.yummy.tv.feature.classic.ui.theme.classicShapes
+import su.afk.yummy.tv.feature.classic.ui.theme.toClassic
+
+@Composable
+fun ClassicThemeWrapper(
+    classicEnabled: Boolean,
+    appTheme: AppTheme,
+    backgroundStyle: BackgroundStyle,
+    isTelevision: Boolean,
+    content: @Composable () -> Unit,
+) {
+    YummyTvTheme(appTheme, backgroundStyle, isTelevision) {
+        CompositionLocalProvider(LocalClassicUi provides classicEnabled) {
+            // M2 bridge is always present: converted screens use M2 components
+            // unconditionally and must follow the app palette in both modes.
+            ClassicMaterialTheme {
+                if (!classicEnabled) {
+                    content()
+                } else {
+                    // Unconverted M3 screens keep working but look classic:
+                    // flat surfaces instead of tonal blobs, square corners.
+                    MaterialTheme(
+                        colorScheme = MaterialTheme.colorScheme.toClassic(),
+                        shapes = classicShapes(),
+                    ) {
+                        content()
+                    }
+                }
+            }
+        }
+    }
+}
