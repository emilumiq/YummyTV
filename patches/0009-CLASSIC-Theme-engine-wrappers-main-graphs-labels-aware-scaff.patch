+package su.afk.yummy.tv.feature.classic.ui.theme
+
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.ColorScheme
+import androidx.compose.material3.Shapes
+import androidx.compose.ui.unit.dp
+
+fun ColorScheme.toClassic(): ColorScheme {
+    // Flatten tonal color blobs into neutral surfaces; contrast pairs stay valid,
+    // so selected states keep readable text on both dark and light schemes.
+    val flatContainer = surfaceVariant
+    val onFlatContainer = onSurfaceVariant
+    return copy(
+        surfaceContainerLowest = surface,
+        surfaceContainerLow = surface,
+        surfaceContainer = surface,
+        surfaceContainerHigh = flatContainer,
+        surfaceContainerHighest = flatContainer,
+        primaryContainer = flatContainer,
+        onPrimaryContainer = onFlatContainer,
+        secondaryContainer = flatContainer,
+        onSecondaryContainer = onFlatContainer,
+        tertiary = secondary,
+        onTertiary = onSecondary,
+        tertiaryContainer = flatContainer,
+        onTertiaryContainer = onFlatContainer,
+    )
+}
+
+fun classicShapes(): Shapes {
+    val square = RoundedCornerShape(0.dp)
+    return Shapes(
+        extraSmall = square,
+        small = square,
+        medium = square,
+        large = square,
+        extraLarge = square,
+    )
+}
