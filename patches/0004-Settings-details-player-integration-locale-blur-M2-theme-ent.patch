diff --git a/core/preferences/src/main/kotlin/su/afk/yummy/tv/core/preferences/locale/AppLocaleContext.kt b/core/preferences/src/main/kotlin/su/afk/yummy/tv/core/preferences/locale/AppLocaleContext.kt
