+package su.afk.yummy.tv.core.preferences.locale
+
+import su.afk.yummy.tv.core.model.settings.AppLocale
+
+/** Synchronous storage: read at startup before setContent, hence not DataStore. */
+interface AppLocalePreferences {
+
+    val selectedLocale: AppLocale
+
+    fun select(locale: AppLocale)
+}
diff --git a/core/preferences/src/main/kotlin/su/afk/yummy/tv/core/preferences/locale/SharedPreferencesAppLocalePreferences.kt b/core/preferences/src/main/kotlin/su/afk/yummy/tv/core/preferences/locale/SharedPreferencesAppLocalePreferences.kt
