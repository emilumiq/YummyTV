+++ b/core/preferences/src/main/kotlin/su/afk/yummy/tv/core/preferences/locale/SharedPreferencesAppLocalePreferences.kt
@@ -0,0 +1,25 @@
+package su.afk.yummy.tv.core.preferences.locale
+
+import android.content.Context
+import dagger.hilt.android.qualifiers.ApplicationContext
+import su.afk.yummy.tv.core.model.settings.AppLocale
+import javax.inject.Inject
+import javax.inject.Singleton
+
+@Singleton
+internal class SharedPreferencesAppLocalePreferences @Inject constructor(
+    @ApplicationContext context: Context,
+) : AppLocalePreferences {
+
+    private val preferences =
+        context.getSharedPreferences(AppLocaleContext.PREFS_NAME, Context.MODE_PRIVATE)
+
+    override val selectedLocale: AppLocale
+        get() = preferences.getString(AppLocaleContext.LOCALE_KEY, null)?.let { value ->
+            runCatching { AppLocale.valueOf(value) }.getOrNull()
+        } ?: AppLocale.SYSTEM
+
+    override fun select(locale: AppLocale) {
+        preferences.edit().putString(AppLocaleContext.LOCALE_KEY, locale.name).apply()
+    }
+}
