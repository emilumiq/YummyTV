@@ -39,3 +39,25 @@ private const val MOBILE_NAV_TRANSITION_MILLIS = 300
 private const val MOBILE_NAV_FADE_IN_MILLIS = 220
 private const val MOBILE_NAV_FADE_OUT_MILLIS = 120
 private const val MOBILE_NAV_EXIT_SHIFT_DIVISOR = 4
+
+/** Classic: plain swipe like stock apps — full slides, no fade overlays. */
+internal val classicNavTransitionSpec: AnimatedContentTransitionScope<Scene<NavKey>>.() -> ContentTransform = {
+    slideInHorizontally(
+        animationSpec = tween(MOBILE_NAV_TRANSITION_MILLIS),
+        initialOffsetX = { it },
+    ) togetherWith slideOutHorizontally(
+        animationSpec = tween(MOBILE_NAV_TRANSITION_MILLIS),
+        targetOffsetX = { -it },
+    )
+}
+
+/** Classic pop: mirror swipe, no fade. */
+internal val classicNavPopTransitionSpec: AnimatedContentTransitionScope<Scene<NavKey>>.() -> ContentTransform = {
+    slideInHorizontally(
+        animationSpec = tween(MOBILE_NAV_TRANSITION_MILLIS),
+        initialOffsetX = { -it },
+    ) togetherWith slideOutHorizontally(
+        animationSpec = tween(MOBILE_NAV_TRANSITION_MILLIS),
+        targetOffsetX = { it },
+    )
+}
