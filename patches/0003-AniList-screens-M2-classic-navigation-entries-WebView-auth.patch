+package su.afk.yummy.tv.feature.tracker.mobile.navigator
+
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import androidx.navigation3.runtime.EntryProviderScope
+import androidx.navigation3.runtime.NavKey
+import su.afk.yummy.tv.core.designsystem.baseScreen.ScreenNavigator
+import su.afk.yummy.tv.core.navigation.manager.INavigationManager
+import su.afk.yummy.tv.feature.tracker.IMobileTrackerEntry
+import su.afk.yummy.tv.feature.tracker.TrackerDestination
+import su.afk.yummy.tv.feature.tracker.TrackerViewModel
+import su.afk.yummy.tv.feature.tracker.mobile.TrackerAuthMobileScreen
+import su.afk.yummy.tv.feature.tracker.mobile.TrackerMobileScreen
+import javax.inject.Inject
+
+class TrackerNavRegistrar @Inject constructor() : IMobileTrackerEntry {
+    override fun register(builder: EntryProviderScope<NavKey>, nav: INavigationManager) =
+        with(builder) {
+            entry<TrackerDestination.TrackerAuth> {
+                val viewModel = hiltViewModel<TrackerViewModel, TrackerViewModel.Factory>(
+                    creationCallback = { factory ->
+                        factory.create(TrackerDestination.TrackerAuth)
+                    },
+                )
+                ScreenNavigator(viewModel) { state, effect, onEvent ->
+                    TrackerAuthMobileScreen(
+                        state = state,
+                        effect = effect,
+                        onEvent = onEvent,
+                    )
+                }
+            }
+            entry<TrackerDestination.TrackerSettings> {
+                val viewModel = hiltViewModel<TrackerViewModel, TrackerViewModel.Factory>(
+                    creationCallback = { factory ->
+                        factory.create(TrackerDestination.TrackerSettings)
+                    },
+                )
+                ScreenNavigator(viewModel) { state, effect, onEvent ->
+                    TrackerMobileScreen(
+                        state = state,
+                        effect = effect,
+                        onEvent = onEvent,
+                    )
+                }
+            }
+            entry<TrackerDestination.TrackerAnime> { dest ->
+                val viewModel = hiltViewModel<TrackerViewModel, TrackerViewModel.Factory>(
+                    creationCallback = { factory -> factory.create(dest) },
+                )
+                ScreenNavigator(viewModel) { state, effect, onEvent ->
+                    TrackerMobileScreen(
+                        state = state,
+                        effect = effect,
+                        onEvent = onEvent,
+                    )
+                }
+            }
+        }
+}
