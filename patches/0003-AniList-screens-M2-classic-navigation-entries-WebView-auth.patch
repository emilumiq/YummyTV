@@ -0,0 +1,71 @@
+package su.afk.yummy.tv.feature.tracker
+
+import androidx.compose.runtime.Immutable
+import kotlinx.collections.immutable.ImmutableList
+import kotlinx.collections.immutable.persistentListOf
+import su.afk.yummy.tv.core.mvi.UiEffect
+import su.afk.yummy.tv.core.mvi.UiEvent
+import su.afk.yummy.tv.core.mvi.UiState
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrack
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrackSearch
+import su.afk.yummy.tv.domain.tracker.model.AnimeTrackStatus
+import su.afk.yummy.tv.domain.tracker.model.TrackerAuthState
+
+class TrackerState {
+    @Immutable
+    data class State(
+        val authState: TrackerAuthState = TrackerAuthState(),
+        val animeId: Long? = null,
+        val animeTitle: String = "",
+        val authUrl: String = "",
+        val isBusy: Boolean = false,
+        val error: String? = null,
+        val searchQuery: String = "",
+        val searchResults: ImmutableList<AnimeTrackSearch> = persistentListOf(),
+        val isSearching: Boolean = false,
+        val binding: AnimeTrack? = null,
+    ) : UiState
+
+    /** User actions on the tracker screens. */
+    sealed interface Event : UiEvent {
+        /** User pressed back. */
+        data object BackSelected : Event
+
+        /** User pressed "Sign in with AniList" — open the in-app OAuth page. */
+        data object LoginClicked : Event
+
+        /** The OAuth page redirected back with a result URI (code flow). */
+        data class AuthCodeReceived(val callbackUri: String) : Event
+
+        /** User signed out of AniList. */
+        data object LogoutClicked : Event
+
+        /** User is typing an anime search query for the AniList catalog. */
+        data class SearchQueryChanged(val query: String) : Event
+
+        /** User submitted the search. */
+        data object SearchSubmitted : Event
+
+        /** User picked a search entry to bind. */
+        data class BindSelected(val search: AnimeTrackSearch) : Event
+
+        /** User requested a binding refresh from the server. */
+        data object RefreshClicked : Event
+
+        /** User confirmed the edit dialog: new status, episode count, score index, privacy. */
+        data class TrackSaved(
+            val status: AnimeTrackStatus,
+            val episodes: Int,
+            val scoreIndex: Int,
+            val private: Boolean,
+        ) : Event
+
+        /** User unlinked the anime from AniList. */
+        data object UnbindClicked : Event
+
+        /** User dismissed the error. */
+        data object ErrorDismissed : Event
+    }
+
+    sealed interface Effect : UiEffect
+}
