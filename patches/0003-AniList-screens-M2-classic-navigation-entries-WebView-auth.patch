+import su.afk.yummy.tv.feature.tracker.tv.view.TrackerEditDialog
+import su.afk.yummy.tv.feature.tracker.tv.view.TrackerLogo
+
+@Composable
+fun TrackerTvScreen(
+    state: TrackerState.State,
+    effect: Flow<TrackerState.Effect>,
+    onEvent: (TrackerState.Event) -> Unit,
+) {
+    // Sign-in runs on the in-app OAuth page (TrackerAuth); no side effects to handle here.
+    TrackerClassicTheme {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 48.dp, vertical = 32.dp),
+            verticalArrangement = Arrangement.spacedBy(20.dp),
+        ) {
+            Text(
+                text = if (state.animeTitle.isNotBlank()) state.animeTitle
+                else stringResource(R.string.tracker_title),
+                style = MaterialTheme.typography.h5,
+                fontWeight = FontWeight.Bold,
+            )
+            if (state.isBusy) {
+                LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
+            }
+            state.error?.let { error ->
+                Text(
+                    text = error,
+                    color = MaterialTheme.colors.error,
+                    style = MaterialTheme.typography.body2,
+                )
+            }
+            if (state.animeId == null) {
+                TrackerTvAuthBlock(state = state, onEvent = onEvent)
+            } else if (!state.authState.isLoggedIn) {
+                TrackerTvLoginBlock(onEvent = onEvent)
+            }
+            if (state.animeId != null) {
+                TrackerTvAnimeBlock(state = state, onEvent = onEvent)
+            }
+        }
+    }
+}
+
+@Composable
+private fun TrackerTvAuthBlock(
+    state: TrackerState.State,
+    onEvent: (TrackerState.Event) -> Unit,
+) {
+    var showLogoutConfirm by remember { mutableStateOf(false) }
+    // Same row as Aniyomi's TrackingPreferenceWidget: logo, name, status check.
+    // Tapping it asks for sign-out confirmation instead of a button below.
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(enabled = state.authState.isLoggedIn) { showLogoutConfirm = true },
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        TrackerLogo()
+        Text(
+            text = stringResource(R.string.tracker_title),
+            modifier = Modifier
+                .weight(1f)
+                .padding(horizontal = 16.dp),
+            style = MaterialTheme.typography.h6,
+        )
+        if (state.authState.isLoggedIn) {
+            Icon(
+                imageVector = Icons.Outlined.Done,
+                contentDescription = null,
+                modifier = Modifier
+                    .padding(4.dp)
+                    .size(36.dp),
+                tint = Color(0xFF4CAF50),
+            )
+        }
+    }
+    if (showLogoutConfirm) {
+        AlertDialog(
+            onDismissRequest = { showLogoutConfirm = false },
+            title = { Text(stringResource(R.string.tracker_logout_title)) },
+            text = {
+                Text(
+                    stringResource(
+                        R.string.tracker_logged_in_as,
+                        state.authState.username.ifBlank { "AniList" },
+                    ),
+                )
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        showLogoutConfirm = false
+                        onEvent(TrackerState.Event.LogoutClicked)
+                    },
+                ) {
+                    Text(stringResource(R.string.tracker_logout))
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = { showLogoutConfirm = false }) {
+                    Text(stringResource(R.string.tracker_cancel))
+                }
+            },
+        )
+    }
+    if (!state.authState.isLoggedIn) {
+        Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text(
+                text = stringResource(R.string.tracker_login_hint),
+                style = MaterialTheme.typography.body1,
+                color = MaterialTheme.colors.onSurface.copy(alpha = 0.6f),
+            )
+            Button(onClick = { onEvent(TrackerState.Event.LoginClicked) }) {
+                Text(stringResource(R.string.tracker_login))
+            }
+        }
+    }
+}
+
+@Composable
+private fun TrackerTvLoginBlock(
+    onEvent: (TrackerState.Event) -> Unit,
+) {
+    Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        Text(
+            text = stringResource(R.string.tracker_login_hint),
+            style = MaterialTheme.typography.body1,
+            color = MaterialTheme.colors.onSurface.copy(alpha = 0.6f),
+        )
+        Button(onClick = { onEvent(TrackerState.Event.LoginClicked) }) {
+            Text(stringResource(R.string.tracker_login))
+        }
+    }
+}
+
+@Composable
+private fun TrackerTvAnimeBlock(
+    state: TrackerState.State,
+    onEvent: (TrackerState.Event) -> Unit,
+) {
+    var showEdit by remember { mutableStateOf(false) }
+    var showMenu by remember { mutableStateOf(false) }
+    val context = LocalContext.current
+    Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        val binding = state.binding
+        if (binding != null) {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                TrackerLogo()
+                Text(
+                    text = binding.title,
+                    modifier = Modifier
+                        .weight(1f)
+                        .padding(horizontal = 16.dp),
+                    style = MaterialTheme.typography.h6,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                IconButton(onClick = { showMenu = true }) {
+                    Icon(Icons.Filled.MoreVert, contentDescription = null)
+                }
+                DropdownMenu(
+                    expanded = showMenu,
+                    onDismissRequest = { showMenu = false },
+                ) {
+                    DropdownMenuItem(
+                        onClick = {
+                            showMenu = false
+                            openTrackerUrl(context, binding.remoteUrl)
+                        },
+                    ) {
+                        Text(stringResource(R.string.tracker_open_in_browser))
+                    }
+                    DropdownMenuItem(
+                        onClick = {
+                            showMenu = false
+                            copyTrackerLink(context, binding.remoteUrl)
+                        },
+                    ) {
+                        Text(stringResource(R.string.tracker_copy_link))
+                    }
+                    DropdownMenuItem(
+                        onClick = {
+                            showMenu = false
+                            onEvent(TrackerState.Event.UnbindClicked)
+                        },
+                    ) {
+                        Text(stringResource(R.string.tracker_unbind))
+                    }
+                }
+            }
+            TrackerTvInfoGrid(
+                state = state,
+                onCellClick = { showEdit = true },
+            )
+            OutlinedButton(onClick = { onEvent(TrackerState.Event.RefreshClicked) }) {
+                Text(stringResource(R.string.tracker_refresh))
+            }
+            if (showEdit) {
+                TrackerEditDialog(
+                    binding = binding,
+                    scoreFormat = state.authState.scoreFormat,
+                    capabilities = AniListCapabilities,
+                    onDismiss = { showEdit = false },
+                    onSave = { status, episodes, scoreIndex, private ->
+                        showEdit = false
+                        onEvent(
+                            TrackerState.Event.TrackSaved(status, episodes, scoreIndex, private),
+                        )
+                    },
+                )
+            }
+        }
+        OutlinedTextField(
+            value = state.searchQuery,
+            onValueChange = { onEvent(TrackerState.Event.SearchQueryChanged(it)) },
+            modifier = Modifier.fillMaxWidth(0.6f),
+            label = { Text(stringResource(R.string.tracker_search_label)) },
+            singleLine = true,
+        )
+        Button(
+            onClick = { onEvent(TrackerState.Event.SearchSubmitted) },
+            enabled = !state.isSearching,
+        ) {
+            Text(stringResource(R.string.tracker_search_action))
+        }
+        if (state.isSearching) {
+            CircularProgressIndicator()
+        }
+        state.searchResults.forEach { item ->
+            TrackerTvSearchRow(
+                item = item,
+                onBind = { onEvent(TrackerState.Event.BindSelected(item)) },
+            )
+        }
+    }
+}
+
+@Composable
+private fun TrackerTvInfoGrid(
+    state: TrackerState.State,
+    onCellClick: () -> Unit,
+) {
+    val binding = state.binding ?: return
+    val context = LocalContext.current
+    val dateFormat = remember { android.text.format.DateFormat.getDateFormat(context) }
+    val dividerColor = MaterialTheme.colors.onSurface.copy(alpha = 0.12f)
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(12.dp))
+            .background(MaterialTheme.colors.onSurface.copy(alpha = 0.06f))
+            .clickable(onClick = onCellClick)
+            .padding(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(IntrinsicSize.Min),
+        ) {
+            TrackerTvInfoCell(
+                label = stringResource(R.string.tracker_status),
+                value = binding.status.label(),
+                modifier = Modifier.weight(1f),
+            )
+            Box(
+                modifier = Modifier
+                    .fillMaxHeight()
+                    .width(1.dp)
+                    .background(dividerColor),
+            )
+            TrackerTvInfoCell(
+                label = stringResource(R.string.tracker_episodes),
+                value = if (binding.totalEpisodes > 0) {
+                    "${binding.lastEpisodeSeen.toInt()} / ${binding.totalEpisodes}"
+                } else {
+                    "${binding.lastEpisodeSeen.toInt()}"
+                },
+                modifier = Modifier.weight(1f),
+            )
+            Box(
+                modifier = Modifier
+                    .fillMaxHeight()
+                    .width(1.dp)
+                    .background(dividerColor),
+            )
+            TrackerTvInfoCell(
+                label = stringResource(R.string.tracker_score),
+                value = if (binding.score != 0.0) {
+                    AniListScoreUtils.displayScore(state.authState.scoreFormat, binding.score)
+                } else {
+                    stringResource(R.string.tracker_not_set)
+                },
+                modifier = Modifier.weight(1f),
+            )
+        }
+        if (binding.startDateMillis > 0 || binding.finishDateMillis > 0) {
+            Divider(color = dividerColor)
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(IntrinsicSize.Min),
+            ) {
+                TrackerTvInfoCell(
+                    label = "",
+                    value = if (binding.startDateMillis > 0) {
+                        dateFormat.format(java.util.Date(binding.startDateMillis))
+                    } else {
+                        stringResource(R.string.tracker_not_set)
+                    },
+                    modifier = Modifier.weight(1f),
+                )
+                Box(
+                    modifier = Modifier
+                        .fillMaxHeight()
+                        .width(1.dp)
+                        .background(dividerColor),
+                )
+                TrackerTvInfoCell(
+                    label = "",
+                    value = if (binding.finishDateMillis > 0) {
+                        dateFormat.format(java.util.Date(binding.finishDateMillis))
+                    } else {
+                        stringResource(R.string.tracker_not_set)
+                    },
+                    modifier = Modifier.weight(1f),
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun TrackerTvInfoCell(
+    label: String,
+    value: String,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier = modifier.padding(horizontal = 4.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        if (label.isNotBlank()) {
+            Text(
+                text = label,
+                style = MaterialTheme.typography.body1,
+                color = MaterialTheme.colors.onSurface.copy(alpha = 0.6f),
+            )
+        }
+        Text(
+            text = value,
+            style = MaterialTheme.typography.h6,
+        )
+    }
+}
+
+@Composable
+private fun TrackerTvSearchRow(
+    item: AnimeTrackSearch,
+    onBind: () -> Unit,
+) {
+    Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(16.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        AsyncImage(
+            model = item.coverUrl,
+            contentDescription = null,
+            modifier = Modifier
+                .size(width = 64.dp, height = 96.dp)
+                .clip(RoundedCornerShape(10.dp)),
+            contentScale = ContentScale.Crop,
+        )
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = item.title,
+                style = MaterialTheme.typography.subtitle1,
+            )
+            if (item.totalEpisodes > 0 || item.score >= 0) {
+                Text(
+                    text = listOfNotNull(
+                        item.totalEpisodes.takeIf { it > 0 }?.let { "$it ep." },
+                        item.score.takeIf { it >= 0 }?.let { "★ ${it.toInt()}" },
+                    ).joinToString(" · "),
+                    style = MaterialTheme.typography.body1,
+                    color = MaterialTheme.colors.onSurface.copy(alpha = 0.6f),
+                )
+            }
+        }
+        OutlinedButton(onClick = onBind) {
+            Text(stringResource(R.string.tracker_bind))
+        }
+    }
+}
