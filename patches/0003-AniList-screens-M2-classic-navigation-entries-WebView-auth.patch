+package su.afk.yummy.tv.feature.tracker.tv.view
+
+import androidx.compose.foundation.isSystemInDarkTheme
+import androidx.compose.material.MaterialTheme
+import androidx.compose.material.darkColors
+import androidx.compose.material.lightColors
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.graphics.Color
+
+private val TwitterBlue = Color(0xFF1D9BF0)
+
+private val ClassicDarkColors = darkColors(
+    primary = TwitterBlue,
+    primaryVariant = Color(0xFF0F4C81),
+    secondary = Color(0xFF71767B),
+    background = Color(0xFF000000),
+    surface = Color(0xFF16181C),
+    error = Color(0xFFF4212E),
+    onPrimary = Color(0xFFFFFFFF),
+    onSecondary = Color(0xFFFFFFFF),
+    onBackground = Color(0xFFE7E9EA),
+    onSurface = Color(0xFFE7E9EA),
+    onError = Color(0xFFFFFFFF),
+)
+
+private val ClassicLightColors = lightColors(
+    primary = TwitterBlue,
+    primaryVariant = Color(0xFF1A8CD8),
+    secondary = Color(0xFF536471),
+    background = Color(0xFFFFFFFF),
+    surface = Color(0xFFFFFFFF),
+    error = Color(0xFFF4212E),
+    onPrimary = Color(0xFFFFFFFF),
+    onSecondary = Color(0xFFFFFFFF),
+    onBackground = Color(0xFF0F1419),
+    onSurface = Color(0xFF0F1419),
+    onError = Color(0xFFFFFFFF),
+)
+
+/**
+ * Classic Material (M2) look for the tracker screens: Twitter-blue accent on
+ * neutral black/white. The rest of the app stays on Material3; both toolkits
+ * render in the same composition.
+ */
+@Composable
+internal fun TrackerClassicTheme(content: @Composable () -> Unit) {
+    MaterialTheme(
+        colors = if (isSystemInDarkTheme()) ClassicDarkColors else ClassicLightColors,
+        content = content,
+    )
+}
